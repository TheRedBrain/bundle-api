{
	"schemaVersion": 1,
	"id": "bundleapi",
	"version": "${version}",
	"name": "Bundle API",
	"description": "An API for mods that allows easy addition of bundles with custom sizes and filtered content.",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/bundle-api"
	},
	"license": "MIT",
	"icon": "assets/bundleapi/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.bundleapi.BundleAPI"
		],
		"client": [
          "com.github.theredbrain.bundleapi.BundleAPIClient"
		]
	},
	"mixins": [
		{
			"config": "bundleapi.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"minecraft": ">=${minecraft_version_compat} <=${minecraft_version}",
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*"
	}
}